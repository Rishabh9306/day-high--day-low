[Unit]
Description=Nifty 50 Breakout Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=draxxy
Group=draxxy
WorkingDirectory=/home/draxxy/dayhigh-daylow
Environment="PATH=/home/draxxy/dayhigh-daylow/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/draxxy/dayhigh-daylow/.venv/bin/python -u /home/draxxy/dayhigh-daylow/main.py
Restart=always
RestartSec=10
StandardOutput=append:/home/draxxy/dayhigh-daylow/logs/bot.log
StandardError=append:/home/draxxy/dayhigh-daylow/logs/bot-error.log

# Logging
SyslogIdentifier=nifty-trading-bot

[Install]
WantedBy=multi-user.target
