kill -9 $(pgrep -f "dayhigh-daylow/main.py") 2>/dev/null

# 3. Generate new access token (opens browser for Kite login)
cd /home/draxxy/Projects/Random/dayhigh-daylow && .venv/bin/python get_access_token.py

# 4. Check & update IP on Kite developer console
cd /home/draxxy/Projects/Random/dayhigh-daylow && .venv/bin/python check_ip.py

# 5. Verify token validity
cd /home/draxxy/Projects/Random/dayhigh-daylow && .venv/bin/python -c "
import config
from kiteconnect import KiteConnect
try:
    kite = KiteConnect(api_key=config.API_KEY)
    kite.set_access_token(config.ACCESS_TOKEN)
    profile = kite.profile()
    print('✅ SUCCESS! Token valid. Connected as:', profile['user_name'])
except Exception as e:
    print('❌ FAILED:', e)
"

